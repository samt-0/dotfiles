#!/usr/bin/env python

import datetime
from ics import Calendar, Event


c = Calendar()
e = Event()
delta = datetime.timedelta(hours=2)

ltitle, ldate = []
with open("demofile.txt", "r") as f:
    for i in f:
        if i % 2 == 0:
            ltitle.append(f)
        else:
            date_obj = datetime.strptime(f, "%d.%m.%Y %H:%M")
            ldate.append(date_obj.isoformat())

for i in ltitle:
    e.summary = ltitle[i]
    e.begin = ldate[i]
    if ldate[i].strftime("%H%M") == "0000":
        e.make_all_day()
    else:
        e.end = ldate[i] + delta
    
    c.events.append(e)


with open("igni.ics", "w", newline='') as f:
    f.write(c.serialize())
