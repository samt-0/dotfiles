#!/usr/bin/env python

import datetime, pytz
from ics import Calendar, Event


c = Calendar()
e = []
delta = {"hours":2}
tz = pytz.timezone("Europe/Vienna")

ltitle, ldate = [], []
with open("plaintext", "r") as f:
    f = f.readlines()
    for i in range(len(f)):
        if i % 2:
            date_obj = datetime.datetime.strptime(f[i].strip(), "%d.%m.%Y %H:%M").replace(tzinfo=tz)
            ldate.append(date_obj)
        else:
           ltitle.append(f[i])


with open("igni.ics", "w", newline='') as f:
    for i in range(len(ltitle)):
        e.append(Event())
        e[i].name = ltitle[i]
        e[i].begin = ldate[i].isoformat()
        if ldate[i].strftime("%H%M") == "0000":
            e[i].make_all_day()
        else:
            e[i].duration = delta
        c.events.add(e[i])
    f.writelines(c.serialize_iter())
