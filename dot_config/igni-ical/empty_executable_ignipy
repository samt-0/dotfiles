#!/usr/bin/env python

import datetime
from ics import Calendar, Event


c = Calendar()
le = list()
e = Event()
delta = {"hours":2}

ltitle, ldate = [], []
with open("plaintext", "r") as f:
    f = f.readlines()
    for i in range(len(f)):
        if i % 2:
            date_obj = datetime.datetime.strptime(f[i].strip(), "%d.%m.%Y %H:%M")
            ldate.append(date_obj)
        else:
           ltitle.append(f[i])


with open("igni.ics", "w", newline='') as f:
    for i in range(len(ltitle)):
        e.name = ltitle[i]
        e.begin = ldate[i].isoformat()
        if ldate[i].strftime("%H%M") == "0000":
            e.make_all_day()
        else:
            e.duration = delta

        c.events.add(e)

    calendar_string = c.serialize()
    print(calendar_string)

